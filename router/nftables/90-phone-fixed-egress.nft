# Owned by phone-panel. Inside fw4's inet fw4 table.
set codex_phone4 {
 type ipv4_addr
 flags interval
}
set codex_phone_mac {
 type ether_addr
}
chain codex_phone_guard {
 type filter hook forward priority -10; policy accept;
 iifname "br-lan" oifname != "br-lan" ip saddr @codex_phone4 counter drop comment "Phone fixed egress: no direct forwarding"
 iifname "br-lan" oifname != "br-lan" ether saddr @codex_phone_mac counter drop comment "Phone fixed egress: IPv6 and address-change guard"
}
chain codex_phone_dns {
 type nat hook prerouting priority -101; policy accept;
}
