#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10
start_service() {
 procd_open_instance doh
 procd_set_param command /usr/bin/sing-box run -c /etc/phone-dns/config.json
 procd_set_param respawn
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
 for I in $(/usr/bin/ruby -ryaml -e 'puts YAML.load_file("/etc/phone-dns/mapping.yaml").map{|g|g["id"]}'); do
  procd_open_instance "cache$I"
  procd_set_param command /usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/phone-dns/group-$I.conf --pid-file=/var/run/phone-dns-$I.pid
  procd_set_param respawn
  procd_set_param stderr 1
  procd_close_instance
 done
}
