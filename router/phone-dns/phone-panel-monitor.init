#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=9
start_service() {
 procd_open_instance monitor
 procd_set_param command /usr/bin/ruby /etc/phone-dns/monitor.rb
 procd_set_param respawn
 procd_set_param term_timeout 20
 procd_set_param stderr 1
 procd_close_instance
}
service_triggers() {
 procd_add_reload_trigger phone_panel
}
